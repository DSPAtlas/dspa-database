MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dspa_importer
MYSQL_PASSWORD=replace-with-importer-secret
MYSQL_DATABASE=dspa_import
DSPA_IDENTITY_DB_USER=dspa_user_manager
DSPA_IDENTITY_DB_PASSWORD=replace-with-identity-secret
DSPA_CONTEXT_DB_USER=dspa_context_manager
DSPA_CONTEXT_DB_PASSWORD=replace-with-context-secret
# Optional local socket for development/tests:
# MYSQL_UNIX_SOCKET=/path/to/mysql.sock
# Reference-data commands require a separate administrative env file with
# MYSQL_DATABASE=dynaprotdbv2 and a suitably privileged MYSQL_USER.
